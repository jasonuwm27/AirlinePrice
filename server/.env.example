# SerpAPI key - get yours at https://serpapi.com/dashboard
SERPAPI_API_KEY=your_serpapi_key_here

# Server port
PORT=3001

# Ground transit cost estimate (USD per mile)
COST_PER_MILE=0.20

# Flight search concurrency
MAX_CONCURRENT_SEARCHES=3
API_BATCH_DELAY_MS=500
SERPAPI_DATE_PAIR_CONCURRENT=2
SERPAPI_DETAIL_CONCURRENT=3

# Search result and credit controls
SERPAPI_MAX_RESULTS=25
SERPAPI_MAX_DATE_PAIRS=30
SERPAPI_EXPANDED_MAX_DATE_PAIRS=90
SERPAPI_MAX_DETAIL_HYDRATIONS=20

# Cache SerpAPI responses for 12 hours by default
SERPAPI_CACHE_TTL_MS=43200000
